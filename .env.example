# Copy this file to .env and fill in your real values.
# Never commit the real .env file to git.

# Your Postgres connection string.
# From Supabase: Project Settings -> Database -> Connection string -> URI
# Use the "Transaction pooler" (port 6543) version for Vercel/serverless.
DATABASE_URL=postgresql://postgres.xxxx:YOUR-PASSWORD@aws-0-xxxx.pooler.supabase.com:6543/postgres

# A long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

PORT=3000
