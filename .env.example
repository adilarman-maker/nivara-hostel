# Copy this file to .env and fill in your real values.
# Never commit the real .env file to git.

# Your Postgres connection string.
# From Supabase: Project Settings -> Database -> Connection string -> URI
# Use the "Session pooler" version (NOT "Transaction pooler") — this app
# pins an RLS session variable per request (see db/pool.js's getOrgClient),
# which Transaction-mode pooling can silently break under real concurrent
# load since it can hand different queries in the same request to
# different backend connections. Session mode keeps one real connection
# per request for its whole lifetime, which is what this pattern needs.
DATABASE_URL=postgresql://postgres.xxxx:YOUR-PASSWORD@aws-0-xxxx.pooler.supabase.com:5432/postgres

# A long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Push notifications (optional — the app runs fine without these, push
# sends just silently no-op until they're set). Generate a pair with:
#   npx web-push generate-vapid-keys
# The private key must never be exposed to the frontend or committed
# anywhere public; the public key is safe to expose (it's meant to be).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=you@example.com

PORT=3000
